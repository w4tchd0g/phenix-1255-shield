(footprint "CONSMA001-SMD-G_EdgeHybrid"
	(version 20260206)
	(generator "pcbnew")
	(generator_version "10.0")
	(layer "F.Cu")
	(descr "Hybrid SMA land pattern: TE/Linx CONSMA001-SMD-G (vertical, SMD, Rev. F recommended footprint) OR Samtec SMA-J-P-H-ST-EM1 (edge mount, 1.57 mm board). Place with the bottom edge (y = +4.4 mm) on the board edge. Populate only one connector. Top side: the edge-mount legs sit on the CONSMA001 GND pads (no separate F.Cu pads, keeps the mask cut-out round). The B.Cu edge-mount pads have no paste and thermal reliefs, solder them by hand after reflow. Edge-mount pads and B.Cu tabs derived from the KiCad library footprint SMA_Samtec_SMA-J-P-H-ST-EM1_EdgeMount (CC-BY-SA 4.0).")
	(tags "SMA coaxial connector vertical SMD edge mount hybrid 50Ohm CONSMA001 Samtec")
